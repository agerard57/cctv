{
  "name": "cctv",
  "private": true,
  "version": "0.0.0",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "npm run lint:code && lint:format && lint:circular && npm run lint:markdown && npm run lint:unused-exports",
    "lint:code": "eslint src/**/*.{js,ts,tsx} --quiet",
    "lint:format": "prettier --write \"src/**/*.{js,ts,tsx,json,css,md}\"",
    "lint:circular": "madge --circular .",
    "lint:markdown": "npx markdownlint-cli2 .",
    "lint:unused-exports": "npx ts-unused-exports ./tsconfig.json",
    "lint:code:fix": "eslint src/**/*.{js,ts,tsx} --fix",
    "deps": "npm-check -u"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.0",
    "@ffmpeg-installer/ffmpeg": "^1.1.0",
    "@mui/icons-material": "^7.0.2",
    "@mui/material": "^7.0.2",
    "axios": "^1.8.4",
    "chart.js": "^4.4.8",
    "chartjs-adapter-date-fns": "^3.0.0",
    "fluent-ffmpeg": "^2.1.3",
    "i18next": "^24.2.2",
    "i18next-browser-languagedetector": "^8.0.4",
    "luxon": "^3.5.0",
    "noisejs": "^2.1.0",
    "react": "^19.0.0",
    "react-chartjs-2": "^5.3.0",
    "react-dom": "^19.0.0",
    "react-i18next": "^15.4.1",
    "react-player": "^2.16.0",
    "react-router-dom": "^7.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.21.0",
    "@types/luxon": "^3.4.2",
    "@types/node": "^22.13.9",
    "@types/noisejs": "^2.1.0",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@typescript-eslint/eslint-plugin": "5.50.0",
    "@typescript-eslint/parser": "5.50.0",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^8.57.1",
    "eslint-config-airbnb-base": "^15.0.0",
    "eslint-config-prettier": "^8.6.0",
    "eslint-import-resolver-alias": "^1.1.2",
    "eslint-import-resolver-typescript": "^3.5.5",
    "eslint-plugin-css-modules": "^2.12.0",
    "eslint-plugin-import": "^2.27.5",
    "eslint-plugin-prettier": "4.2.1",
    "eslint-plugin-react": "^7.37.4",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "globals": "^15.15.0",
    "madge": "^8.0.0",
    "markdownlint-cli2": "^0.17.2",
    "npm-check": "^6.0.1",
    "prettier": "^3.5.3",
    "ts-unused-exports": "^9.0.4",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.26.0",
    "vite": "^6.2.0"
  }
}
